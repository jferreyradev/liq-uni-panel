# ==============================================================================
# CONFIGURACIÓN DEL PANEL DE SUELDOS (liq-panel)
# ==============================================================================
# Copia este archivo como .env o .env.local para configurar tus credenciales:
#   cp .env.example .env.local
# ==============================================================================

# 1. Dirección Base de la API (node-apiliq)
# Producción (Raspberry Pi / Cloudflare Tunnel):
VITE_API_URL=https://api-rpi.liqsysonline.com

# Desarrollo (Servidor cloud de pruebas):
# VITE_API_URL=https://api-desa.liqsysonline.com

# Localhost:
# VITE_API_URL=http://localhost:3005

# 2. Clave de Cliente Frontend (X-API-Key)
# Requerida cuando la API tiene activado REQUIRE_AUTH=true.
# Permite autenticar la aplicación en POST /api/auth/login antes de obtener el token Bearer JWT.
VITE_API_KEY=tu_api_client_key_aqui

# 3. Clave Maestra de Administrador (Opcional)
# VITE_ADMIN_KEY=tu_admin_access_key_aqui
