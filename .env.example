# ==============================================================================
# CONFIGURACIÓN DEL PANEL DE SUELDOS (liq-panel)
# ==============================================================================
# Copia este archivo como .env o .env.local para configurar tus credenciales:
#   cp .env.example .env.local
# ==============================================================================

# ==============================================================================
# OPCIÓN A: Múltiples Ambientes de Servidores (VITE_API_ENVIRONMENTS)
# ==============================================================================
# Permite conmutar dinámicamente entre servidores desde el selector de la barra superior.
# Cada servidor define su id, nombre, url y su respectiva apiKey (X-API-Key).
VITE_API_ENVIRONMENTS='[
  {
    "id": "servidor-prod",
    "nombre": "Producción",
    "url": "https://<HOST_API_PRODUCCION>",
    "apiKey": "<TU_API_KEY_PRODUCCION>"
  },
  {
    "id": "servidor-desa",
    "nombre": "Desarrollo",
    "url": "https://<HOST_API_DESARROLLO>",
    "apiKey": "<TU_API_KEY_DESARROLLO>"
  }
]'

# ==============================================================================
# OPCIÓN B: Configuración Simple de Servidor Único
# ==============================================================================
# VITE_API_URL="https://<HOST_API>"
# VITE_API_KEY="<TU_API_KEY>"
# VITE_ADMIN_KEY="<TU_ADMIN_KEY>"
