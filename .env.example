# ==============================================================================
# CONFIGURACIÓN DEL PANEL DE SUELDOS (liq-panel)
# ==============================================================================
# Copia este archivo como .env o .env.local para configurar tus credenciales:
#   cp .env.example .env.local
# ==============================================================================

# ==============================================================================
# OPCIÓN A: Múltiples Ambientes de Servidores (VITE_API_ENVIRONMENTS / API_ENVIRONMENTS)
# ==============================================================================
# Permite conmutar dinámicamente entre servidores desde el selector de la barra superior.
# Cada servidor define su URL y su respectiva apiKey (X-API-Key).
VITE_API_ENVIRONMENTS='[
  {
    "id": "rpi-desa",
    "nombre": "Producción (Raspberry Pi)",
    "url": "https://api-desa.liqsysonline.com",
    "apiKey": "admin987front"
  },
  {
    "id": "rpi-tv",
    "nombre": "Desarrollo Local",
    "url": "https://api-tv.liqsysonline.com",
    "apiKey": "f098tv"
  }
]'

# ==============================================================================
# OPCIÓN B: Configuración Simple de Servidor Único
# ==============================================================================
# VITE_API_URL=https://api-desa.liqsysonline.com
# VITE_API_KEY=admin987front
# VITE_ADMIN_KEY=clave_admin_opcional
